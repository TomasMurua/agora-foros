# Copiar a deploy/.env en la VM y completar. deploy/.env no se sube al repositorio.

# Container Registry desde donde se descargan las imágenes (sin https://)
REGISTRY=agoraforos.azurecr.io
TAG=2.0.0

# Dominio público de la VM (Caddy saca el certificado HTTPS para este nombre)
DOMINIO=agora-foros.eastus2.cloudapp.azure.com

# Clave que firma los tokens: generar con  openssl rand -base64 48
JWT_SECRET=

# Base de datos, opción 1: Oracle en un contenedor de esta misma VM.
COMPOSE_PROFILES=oracle-local
ORACLE_PASSWORD=
DB_URL=jdbc:oracle:thin:@//oracle:1521/FREEPDB1

# Base de datos, opción 2: Oracle Cloud (Autonomous Database).
# Borrar las tres líneas de arriba, copiar el Wallet descomprimido en deploy/wallet/ y usar:
# DB_URL=jdbc:oracle:thin:@<nombre_de_la_base>_high?TNS_ADMIN=/wallet
# Las claves de USUARIOS_MS, FORO_MS y MODERACION_MS son las de bd/01_crear_esquemas.sql; si se cambian:
# DB_PASSWORD_USUARIOS=
# DB_PASSWORD_FORO=
# DB_PASSWORD_MODERACION=
